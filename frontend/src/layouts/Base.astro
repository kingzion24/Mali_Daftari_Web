---
import '../styles/app.css';
import { getLocale, getTheme, makeT } from '../lib/i18n';

interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
const locale = getLocale(Astro);
const theme = getTheme(Astro);
const t = makeT(locale);

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const nav = [
  { group: 'grp.overview', items: [{ href: '/', key: 'nav.dashboard', icon: 'grid' }] },
  {
    group: 'grp.distribution',
    items: [
      { href: '/orders', key: 'nav.orders', icon: 'cart' },
      { href: '/standing', key: 'nav.standing', icon: 'cycle2' },
      { href: '/containers', key: 'nav.containers', icon: 'cycle' },
    ],
  },
  {
    group: 'grp.sales',
    items: [
      { href: '/report', key: 'nav.report', icon: 'chart' },
      { href: '/invoices', key: 'nav.invoices', icon: 'doc' },
      { href: '/customers', key: 'nav.customers', icon: 'store' },
    ],
  },
  { group: 'grp.crm', items: [{ href: '/pipeline', key: 'nav.pipeline', icon: 'columns' }] },
];

const icons: Record<string, string> = {
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  cart: '<circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.2 12.3a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/>',
  cycle: '<path d="M3 11a8 8 0 0 1 14-5m1 0V3m0 3h-3"/><path d="M21 13a8 8 0 0 1-14 5m-1 0v3m0-3h3"/>',
  cycle2: '<path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>',
  chart: '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
  doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/>',
  store: '<path d="M3 9l1-5h16l1 5"/><path d="M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"/><path d="M9 20v-6h6v6"/>',
  columns: '<rect x="3" y="4" width="5" height="16" rx="1.5"/><rect x="10" y="4" width="5" height="11" rx="1.5"/><rect x="17" y="4" width="4" height="14" rx="1.5"/>',
};
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Living Water</title>
    <meta name="description" content="Living Water — water distribution operations" />
  </head>
  <body>
    <div class="app">
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-mark">LW</div>
          <div>
            <div class="brand-name">Living Water</div>
            <div class="brand-sub">{t('brand.sub')}</div>
          </div>
        </div>

        {
          nav.map((section) => (
            <>
              <div class="nav-group-label">{t(section.group)}</div>
              {section.items.map((item) => (
                <a href={item.href} class={`nav-item${isActive(item.href) ? ' active' : ''}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
                  <span>{t(item.key)}</span>
                </a>
              ))}
            </>
          ))
        }
      </aside>

      <div class="main">
        <header class="topbar">
          <div>
            <h1>{title}</h1>
            {subtitle && <div class="sub">{subtitle}</div>}
          </div>
          <div class="tools">
            <div class="seg" role="group" aria-label={t('ui.language')}>
              <button type="button" data-lang="en" class={locale === 'en' ? 'on' : ''}>EN</button>
              <button type="button" data-lang="sw" class={locale === 'sw' ? 'on' : ''}>SW</button>
            </div>
            <button type="button" id="themeToggle" class="icon-btn" aria-label={t('ui.theme')}>
              <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></svg>
            </button>
            <slot name="actions" />
          </div>
        </header>
        <main class="content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      const sun = '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>';
      const moon = '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>';
      const setCookie = (k: string, v: string) =>
        (document.cookie = `${k}=${v};path=/;max-age=31536000`);

      const icon = document.getElementById('themeIcon');
      const paint = () =>
        (icon!.innerHTML =
          document.documentElement.dataset.theme === 'dark' ? sun : moon);
      paint();

      document.getElementById('themeToggle')?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        setCookie('theme', next);
        paint();
      });

      document.querySelectorAll<HTMLButtonElement>('.seg button').forEach((b) => {
        b.addEventListener('click', () => {
          setCookie('lang', b.dataset.lang!);
          location.reload();
        });
      });
    </script>
  </body>
</html>
