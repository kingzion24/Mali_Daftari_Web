---
import Base from '../layouts/Base.astro';
import { api, money, num, shortDate } from '../lib/api';
import { getLocale, makeT } from '../lib/i18n';

const t = makeT(getLocale(Astro));

let summary: any = null;
let rows: any[] = [];
let error: string | null = null;
try {
  const data = await api('/containers');
  summary = data.summary;
  rows = data.rows ?? [];
} catch (e) {
  error = (e as Error).message;
}

const returnRate = summary && summary.issued > 0 ? Math.round((summary.returned / summary.issued) * 100) : 0;
const outClass = (n: number) => (n >= 100 ? 'rose' : n >= 50 ? 'amber' : 'green');
---

<Base title={t('nav.containers')} subtitle={t('containers.sub')}>
  {error && <div class="panel panel-pad" style="color:var(--rose)">API error: {error}</div>}

  {summary && (
    <>
      <div class="stats rise rise-1">
        <div class="stat">
          <div class="label">{t('col.outstanding')}</div>
          <div class="value accent tabnum">{num(summary.outstanding)}</div>
          <div class="meta">{num(summary.issued)} {t('col.issued')} · {num(summary.returned)} {t('col.returned')}</div>
        </div>
        <div class="stat">
          <div class="label">{t('col.deposit')}</div>
          <div class="value tabnum">{money(summary.deposit_held)}</div>
        </div>
        <div class="stat">
          <div class="label">{t('kpi.return_rate')}</div>
          <div class="value tabnum">{returnRate}%</div>
        </div>
        <div class="stat">
          <div class="label">{t('sec.overdue_invoices')}</div>
          <div class={`value tabnum ${summary.high > 0 ? 'rose' : 'emerald'}`}>{summary.high}</div>
          <div class="meta">100+ {t('col.outstanding').toLowerCase()}</div>
        </div>
      </div>

      <div class="table-wrap" style="margin-top:18px">
        <table>
          <thead>
            <tr>
              <th>{t('col.customer')}</th>
              <th>{t('col.route')}</th>
              <th class="r">{t('col.issued')}</th>
              <th class="r">{t('col.returned')}</th>
              <th class="r">{t('col.outstanding')}</th>
              <th class="r">{t('col.deposit')}</th>
              <th>{t('col.last_move')}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="cell-strong">{r.customer}</td>
                <td class="cell-dim">{r.route ?? '—'}</td>
                <td class="r tabnum">{num(r.issued)}</td>
                <td class="r tabnum cell-dim">{num(r.returned)}</td>
                <td class="r"><span class={`badge ${outClass(r.outstanding)}`}>{num(r.outstanding)}</span></td>
                <td class="r tabnum">{money(r.deposit_held)}</td>
                <td class="cell-dim">{shortDate(r.last_movement)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</Base>
