---
import Base from '../layouts/Base.astro';
import { api, money } from '../lib/api';
import { getLocale, makeT } from '../lib/i18n';

const t = makeT(getLocale(Astro));

let customers: any[] = [];
let error: string | null = null;
try {
  const data = await api('/customers');
  customers = data.customers ?? [];
} catch (e) {
  error = (e as Error).message;
}

const typeClass: Record<string, string> = { distributor: 'blue', hotel: 'amber', office: 'blue', retailer: 'green', household: 'gray' };
---

<Base title={t('nav.customers')} subtitle={`${customers.length} — ${t('customers.sub')}`}>
  {error && <div class="panel panel-pad" style="color:var(--rose)">API error: {error}</div>}

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>{t('col.business')}</th>
          <th>{t('col.type')}</th>
          <th>{t('col.route')}</th>
          <th>{t('col.tier')}</th>
          <th class="r">{t('col.credit')}</th>
          <th class="r">{t('col.balance')}</th>
        </tr>
      </thead>
      <tbody>
        {customers.map((c) => (
          <tr>
            <td class="cell-strong">{c.name}</td>
            <td><span class={`badge ${typeClass[c.type] ?? 'gray'}`}>{c.type}</span></td>
            <td class="cell-dim">{c.route ?? '—'}</td>
            <td><span class="badge gray">{c.price_tier}</span></td>
            <td class="r tabnum">{money(c.credit_limit)}</td>
            <td class="r tabnum" style={Number(c.balance) > 0 ? 'color:var(--rose);font-weight:600' : 'color:var(--emerald)'}>{money(c.balance)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
