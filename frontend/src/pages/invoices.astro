---
import Base from '../layouts/Base.astro';
import { api, money, shortDate } from '../lib/api';
import { getLocale, makeT } from '../lib/i18n';

const t = makeT(getLocale(Astro));

let invoices: any[] = [];
let error: string | null = null;
try {
  const data = await api('/invoices');
  invoices = data.invoices ?? [];
} catch (e) {
  error = (e as Error).message;
}

const badgeClass: Record<string, string> = { paid: 'green', partial: 'amber', overdue: 'rose', unpaid: 'gray' };
const outstanding = invoices.reduce((s, i) => s + (Number(i.amount) - Number(i.amount_paid)), 0);
---

<Base title={t('nav.invoices')} subtitle={t('invoices.sub')}>
  {error && <div class="panel panel-pad" style="color:var(--rose)">API error: {error}</div>}

  <div class="stats rise rise-1" style="--cols:3;margin-bottom:18px">
    <div class="stat"><div class="label">{t('nav.invoices')}</div><div class="value tabnum">{invoices.length}</div></div>
    <div class="stat"><div class="label">{t('kpi.receivables')}</div><div class="value rose tabnum">{money(outstanding)}</div></div>
    <div class="stat"><div class="label">{t('kpi.overdue')}</div><div class="value tabnum">{invoices.filter((i) => i.status === 'overdue').length}</div></div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>{t('col.invoice_no')}</th>
          <th>{t('col.customer')}</th>
          <th>{t('col.issue_date')}</th>
          <th>{t('col.due_date')}</th>
          <th class="r">{t('col.total')}</th>
          <th class="r">{t('col.paid')}</th>
          <th>{t('col.status')}</th>
        </tr>
      </thead>
      <tbody>
        {invoices.map((i) => (
          <tr>
            <td class="cell-mono">{i.invoice_no}</td>
            <td class="cell-strong">{i.customer}</td>
            <td>{shortDate(i.issue_date)}</td>
            <td class="cell-dim">{shortDate(i.due_date)}</td>
            <td class="r tabnum">{money(i.amount)}</td>
            <td class="r tabnum cell-dim">{money(i.amount_paid)}</td>
            <td><span class={`badge ${badgeClass[i.status] ?? 'gray'}`}>{i.status}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
