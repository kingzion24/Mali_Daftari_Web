---
import Base from '../layouts/Base.astro';
import { api, money, shortDate } from '../lib/api';
import { getLocale, makeT } from '../lib/i18n';

const t = makeT(getLocale(Astro));
const url = Astro.url;
const status = url.searchParams.get('status') ?? '';
const search = url.searchParams.get('search') ?? '';

const qs = new URLSearchParams();
if (status) qs.set('status', status);
if (search) qs.set('search', search);

let orders: any[] = [];
let error: string | null = null;
try {
  const data = await api(`/orders${qs.toString() ? '?' + qs.toString() : ''}`);
  orders = data.orders ?? [];
} catch (e) {
  error = (e as Error).message;
}

const total = orders.reduce((s, o) => s + Number(o.total), 0);
const badgeClass: Record<string, string> = { delivered: 'green', loaded: 'blue', pending: 'gray', cancelled: 'rose' };
const statuses = ['', 'pending', 'loaded', 'delivered', 'cancelled'];
---

<Base title={t('nav.orders')} subtitle={t('orders.sub')}>
  <form class="toolbar" method="get">
    <div class="field">
      <label>{t('f.status')}</label>
      <select class="input" name="status">
        {statuses.map((s) => (
          <option value={s} selected={s === status}>{s ? s[0].toUpperCase() + s.slice(1) : t('f.all_statuses')}</option>
        ))}
      </select>
    </div>
    <div class="field">
      <label>{t('f.search_order')}</label>
      <input class="input" type="text" name="search" value={search} placeholder="SO-…" />
    </div>
    <button class="btn btn-primary" type="submit">{t('f.apply')}</button>
    {(status || search) && <a class="btn btn-ghost" href="/orders">{t('f.reset')}</a>}
  </form>

  {error && <div class="panel panel-pad" style="color:var(--rose)">API error: {error}</div>}

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>{t('col.order_no')}</th>
          <th>{t('col.customer')}</th>
          <th>{t('col.route')}</th>
          <th>{t('col.ordered')}</th>
          <th>{t('col.delivered')}</th>
          <th>{t('col.status')}</th>
          <th class="r">{t('col.total')}</th>
        </tr>
      </thead>
      <tbody>
        {orders.length === 0 && <tr><td colspan="7" class="empty">{t('rep.none')}</td></tr>}
        {orders.map((o) => (
          <tr>
            <td class="cell-mono">{o.order_no}</td>
            <td class="cell-strong">{o.customer}</td>
            <td class="cell-dim">{o.route}</td>
            <td>{shortDate(o.order_date)}</td>
            <td class="cell-dim">{shortDate(o.delivery_date)}</td>
            <td><span class={`badge ${badgeClass[o.status] ?? 'gray'}`}>{o.status}</span></td>
            <td class="r tabnum">{money(o.total)}</td>
          </tr>
        ))}
      </tbody>
      {orders.length > 0 && (
        <tfoot>
          <tr>
            <td colspan="6">{t('rep.total_line')} — {orders.length}</td>
            <td class="r tabnum">{money(total)}</td>
          </tr>
        </tfoot>
      )}
    </table>
  </div>
</Base>
